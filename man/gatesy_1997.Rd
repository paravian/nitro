                       package = "nitro")
nex_16s <- system.file("extdata", "gatesy_1997_16s.nex",
                       package = "nitro")

dm_12s <- read.nexus.data(nex_12s) |>
  as.alignment() |>
  as.phyDat(type = "DNA") |>
  create_matrix()

dm_16s <- read.nexus.data(nex_16s) |>
  as.alignment() |>
  as.phyDat(type = "DNA") |>
  create_matrix()
